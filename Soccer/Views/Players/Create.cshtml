@model Soccer.Models.Player

@{
    ViewData["Title"] = "Створити";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Додати нового гравця</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Name" class="control-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="BirthYear" class="control-label fw-bold"></label>
                <input asp-for="BirthYear" class="form-control" />
                <span asp-validation-for="BirthYear" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Position" class="control-label fw-bold"></label>
                <input asp-for="Position" class="form-control" />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="TeamId" class="control-label fw-bold">Команда</label>
                <select asp-for="TeamId" class="form-select" asp-items="ViewBag.TeamId"></select>
            </div>
            
            <div class="mb-3">
                <input type="submit" value="Створити" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}