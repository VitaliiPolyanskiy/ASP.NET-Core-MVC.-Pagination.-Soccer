@model Soccer.Models.Player

@{
    ViewData["Title"] = "Деталі";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <h4>Деталі гравця</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        
        <dt class="col-sm-3">
            Вік гравця
        </dt>
        <dd class="col-sm-9">
            @(DateTime.Now.Year - Model.BirthYear)
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Position)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Position)
        </dd>
        
        <dt class="col-sm-3">
            Команда
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Team!.Name)
        </dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Редагувати</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
</div>