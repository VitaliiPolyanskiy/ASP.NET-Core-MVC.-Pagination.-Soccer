@model Soccer.Models.Player

@{
    ViewData["Title"] = "Видалити";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3 class="text-danger">Ви впевнені, що хочете видалити цього гравця?</h3>
<div>
    <h4>Гравець</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        
        <dt class="col-sm-3">
            Вік гравця
        </dt>
        <dd class="col-sm-9">
            @(DateTime.Now.Year - Model.BirthYear)
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Position)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Position)
        </dd>
        
        <dt class="col-sm-3">
            Команда
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Team!.Name)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
    </form>
</div>